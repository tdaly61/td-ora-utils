# ee/.env.sample — Database Free / Enterprise Edition two-container POC config.
# Copy to ee/.env and edit. This is a FRESH schema, deliberately NOT the same
# as adb/.env — the two toolkits target different container topologies (see
# td-ora-utils/CLAUDE.md and ee/README.md). adb/.env is only ever read (never
# written) by these scripts, for host tooling genuinely shared between the
# two: Instant Client location and the DEFAULT_PASSWORD used to seed the
# compat ADMIN user below.

# ─────────────────────────────────────────────
# ORACLE CONTAINER REGISTRY
# Accept the licence for Database -> Free (and, later, Enterprise Edition)
# and for Database -> Oracle REST Data Services at
# https://container-registry.oracle.com before first pull.
# ─────────────────────────────────────────────
ORACLE_REGISTRY_USER=your-oracle-sso-email@example.com
ORACLE_REGISTRY_PASSWORD=CHANGE_ME_oracle_registry_token

# ─────────────────────────────────────────────
# DATABASE IMAGE — staged rollout.
#
# Phase 1 default: gvenzl/oracle-free (Docker Hub, no OTN registry login or
# license click-through required) — a widely-used repackaging of the same
# official Oracle Database Free binaries. This is what unblocks a fully
# unattended full-cycle-test run with zero credentials.
#
# Swap to the official container-registry.oracle.com image (Free, or later
# Enterprise Edition if load testing shows Free's 2GB combined SGA+PGA cap is
# still hit — see td-ora-utils/CLAUDE.md and the ee POC plan) once you've
# accepted the licence and set ORACLE_REGISTRY_USER/PASSWORD below.
# IMPORTANT: switching to an official Oracle image is NOT a pure one-line
# change — it also uses a different default PDB name (ORCLPDB1, not
# FREEPDB1) and a different password env var (ORACLE_PWD, not
# ORACLE_PASSWORD internally mapped in docker-compose.yml) — update
# ORACLE_PDB below and docker-compose.yml's `environment:` block for
# oracle-db together with this line. Do not use :latest on either family —
# pin an explicit tag and verify it exists first.
# ─────────────────────────────────────────────
DOCKER_IMAGE=gvenzl/oracle-free:23.26.2
# Official Oracle Free (requires registry login — see below):
# DOCKER_IMAGE=container-registry.oracle.com/database/free:23.26.1.0
# Enterprise Edition swap-in value (requires registry login — see below):
# DOCKER_IMAGE=container-registry.oracle.com/database/enterprise:23.26.1.0

# No official ORDS container image is used here (it's also gated behind the
# same OTN registry login as the DB images) — ORDS runs standalone from a
# plain zip download (see download-ords.sh) inside a generic, unauthenticated
# JRE base image instead.
ORDS_JAVA_IMAGE=eclipse-temurin:21-jre-jammy
ORDS_DOWNLOAD_URL=https://download.oracle.com/otn_software/java/ords/ords-latest.zip
ORDS_INSTALL_DIR=./ords-install
ORDS_CACHE_DIR=~/.cache/oracle-ords

CONTAINER_NAME=caseweave-ee-db
ORDS_CONTAINER_NAME=caseweave-ee-ords
DB_HOSTNAME=ee.local

# Host-side SQL*Net / EM Express ports. Not 1521/1522 by default because
# ../adb/'s adb-free container commonly already occupies those on the same
# host (check `docker ps` if unsure) — adb/ is never touched to free them up.
DB_HOST_PORT=1523
EM_EXPRESS_HOST_PORT=5500

# Sets the DB password on first boot (mapped to ORACLE_PASSWORD for the
# gvenzl image, or ORACLE_PWD for official Oracle images — see
# docker-compose.yml), and APEX_PWD used by ORDS to complete the APEX install.
ORACLE_PWD=CHANGE_ME_choose_a_strong_password

# Default PDB name — FREEPDB1 on gvenzl/oracle-free (fixed, not
# configurable); ORCLPDB1 on official Oracle Free/Enterprise Edition images.
# Must match whichever DOCKER_IMAGE family is active above.
ORACLE_PDB=FREEPDB1

# ─────────────────────────────────────────────
# HOST DIRECTORIES — created by setup-for-ee.sh. Paths are resolved relative
# to this directory and validated to stay under it before any cleanup step
# (ee/run-ee.sh -c) is allowed to rm -rf them.
# ─────────────────────────────────────────────
DB_DATA_DIR=./oradata
ORDS_CONFIG_DIR=./ords_config
APEX_INSTALL_DIR=./apex-install

# ─────────────────────────────────────────────
# APEX / ORDS
# ─────────────────────────────────────────────
APEX_PORT=8080
APEX_VERSION=26.1
APEX_DOWNLOAD_URL=https://download.oracle.com/otn_software/apex/apex_26.1_en.zip
# Cache dir so repeated full-cycle test runs don't re-download the zip every
# time — only the extracted copy under APEX_INSTALL_DIR is wiped by cleanup.
APEX_CACHE_DIR=~/.cache/oracle-apex

# ─────────────────────────────────────────────
# COMPATIBILITY ADMIN USER
# Plain Oracle (Free or EE) has no ADMIN user by default — adb/load-apex-app.sh
# assumes one exists (it does on ADB-Free). create-admin-compat-user.sql.tpl
# mints a real DBA-privileged ADMIN user here so that script can be reused
# unmodified. Leave blank to reuse adb/.env's DEFAULT_PASSWORD (read-only).
# ─────────────────────────────────────────────
ADMIN_COMPAT_PASSWORD=

# ─────────────────────────────────────────────
# OLLAMA (host) — no proxy container needed here: unlike ADB-Free, neither
# Database Free nor Enterprise Edition force outbound-HTTPS-only, so UTL_HTTP
# can call the host directly.
# ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# ─────────────────────────────────────────────
# TIMEOUTS (seconds) — generous enough to cover a cold image pull plus first
# boot / first APEX install. Used by run-ee.sh and the full-cycle test.
# ─────────────────────────────────────────────
DB_HEALTHY_TIMEOUT=900
ORDS_HEALTHY_TIMEOUT=600

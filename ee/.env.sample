# ee/.env.sample — Oracle Database Enterprise Edition two-container POC
# config. Copy to ee/.env and edit. This is a FRESH schema, deliberately NOT
# the same as adb/.env — the two toolkits target different container
# topologies (see td-ora-utils/CLAUDE.md and ee/README.md). adb/.env is only
# ever read (never written) by these scripts, for host tooling genuinely
# shared between the two: Instant Client location and the DEFAULT_PASSWORD
# used to seed the compat ADMIN user below.

# ─────────────────────────────────────────────
# ORACLE CONTAINER REGISTRY — required. Accept the licence for
# Database -> Enterprise Edition at https://container-registry.oracle.com
# before first pull, and set your Oracle SSO email/password (or auth token)
# below. Used under the free OTN Developer License Terms:
# developing/testing/prototyping/demonstrating only, single developer /
# single workstation, no production/business/commercial data processing, no
# redistribution to third parties (see README.md).
# ─────────────────────────────────────────────
ORACLE_REGISTRY_USER=your-oracle-sso-email@example.com
ORACLE_REGISTRY_PASSWORD=CHANGE_ME_oracle_registry_token

# ─────────────────────────────────────────────
# DATABASE IMAGE — official Oracle Database Enterprise Edition, pulled from
# container-registry.oracle.com (OTN registry login required — see above).
# Chosen over Database Free because Free's 2GB combined SGA+PGA cap is a hard
# vendor limit that broke caseweave's vector-embedding workers (ORA-04036)
# against ADB-Free, and would hit the same wall here. Do not use :latest —
# pin an explicit tag and verify it exists first.
# ─────────────────────────────────────────────
DOCKER_IMAGE=container-registry.oracle.com/database/enterprise:23.26.1.0

# No official ORDS container image is used here (it's also gated behind the
# same OTN registry login as the DB images) — ORDS runs standalone from a
# plain zip download (see download-ords.sh) inside a generic, unauthenticated
# JRE base image instead.
ORDS_JAVA_IMAGE=eclipse-temurin:21-jre-jammy
ORDS_DOWNLOAD_URL=https://download.oracle.com/otn_software/java/ords/ords-latest.zip
ORDS_INSTALL_DIR=./ords-install
ORDS_CACHE_DIR=~/.cache/oracle-ords

CONTAINER_NAME=caseweave-ee-db
ORDS_CONTAINER_NAME=caseweave-ee-ords
DB_HOSTNAME=ee.local

# Host-side SQL*Net / EM Express ports. Defaults assume adb-free (which also
# wants 1521/1522) is stopped. If you need both running side by side, set
# DB_HOST_PORT to something else (e.g. 1523) — adb/ is never touched to free
# these up automatically.
DB_HOST_PORT=1521
EM_EXPRESS_HOST_PORT=5500

# Sets the DB password on first boot (mapped to ORACLE_PWD in
# docker-compose.yml), and APEX_PWD used by ORDS to complete the APEX install.
ORACLE_PWD=CHANGE_ME_choose_a_strong_password

# Default PDB name on official Oracle Database images (Free and Enterprise
# Edition alike) is ORCLPDB1 — not configurable without also changing
# docker-compose.yml.
ORACLE_PDB=ORCLPDB1

# ─────────────────────────────────────────────
# HOST DIRECTORIES — created by setup-for-ee.sh. Paths are resolved relative
# to this directory and validated to stay under it before any cleanup step
# (ee/run-ee.sh -c) is allowed to rm -rf them.
# ─────────────────────────────────────────────
DB_DATA_DIR=./oradata
ORDS_CONFIG_DIR=./ords_config
APEX_INSTALL_DIR=./apex-install

# ─────────────────────────────────────────────
# APEX / ORDS
# ─────────────────────────────────────────────
APEX_PORT=8080
APEX_VERSION=26.1
APEX_DOWNLOAD_URL=https://download.oracle.com/otn_software/apex/apex_26.1_en.zip
# Cache dir so repeated full-cycle test runs don't re-download the zip every
# time — only the extracted copy under APEX_INSTALL_DIR is wiped by cleanup.
APEX_CACHE_DIR=~/.cache/oracle-apex

# ─────────────────────────────────────────────
# COMPATIBILITY ADMIN USER
# Plain Oracle Database (Enterprise Edition here) has no ADMIN user by default — adb/load-apex-app.sh
# assumes one exists (it does on ADB-Free). create-admin-compat-user.sql.tpl
# mints a real DBA-privileged ADMIN user here so that script can be reused
# unmodified. Leave blank to reuse adb/.env's DEFAULT_PASSWORD (read-only).
# ─────────────────────────────────────────────
ADMIN_COMPAT_PASSWORD=

# ─────────────────────────────────────────────
# OLLAMA (host) — no proxy container needed here: unlike ADB-Free,
# Enterprise Edition does not force outbound-HTTPS-only, so UTL_HTTP can
# call the host directly.
#
# LINUX HOSTS ONLY (typically hardened cloud VMs — NOT macOS/Colima): if the
# host firewall has a default-deny iptables INPUT chain, the DB container's
# calls to Ollama will fail with ORA-29273 even though Ollama itself is
# running fine — this is a host firewall rule, not an Ollama problem.
# run-ee.sh detects this and prints the exact `sudo iptables ...` command to
# run by hand. Set ALLOW_FIREWALL_AUTOFIX=true here to have it apply that
# fix automatically instead (needs root or passwordless sudo) — left false
# by default since modifying host firewall rules is a persistent, host-level
# change that shouldn't happen silently on a host that's never seen this
# before.
# ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
ALLOW_FIREWALL_AUTOFIX=false

# ─────────────────────────────────────────────
# TIMEOUTS (seconds) — generous enough to cover a cold image pull plus first
# boot / first APEX install. Used by run-ee.sh and the full-cycle test.
# ─────────────────────────────────────────────
DB_HEALTHY_TIMEOUT=900
ORDS_HEALTHY_TIMEOUT=600
